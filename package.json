{
  "name": "matcha-api",
  "version": "1.0.0",
  "main": "index.js",
  "type": "commonjs",
  "repository": "git@github.com:joinmatcha/matcha-api.git",
  "author": "joinmatcha",
  "license": "MIT",
  "scripts": {
    "dev": "yarn mongo:start && yarn dev:api",
    "dev:api": "ts-node-dev --respawn --transpile-only --require tsconfig-paths/register src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "prepare": "husky",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "test": "NODE_ENV=test jest --config jest.config.cjs --runInBand --detectOpenHandles",
    "test:coverage": "NODE_ENV=test jest --config jest.config.cjs --runInBand --detectOpenHandles --coverage",
    "cleanup:users": "ts-node src/scripts/cleanup-unverified-users.ts --once",
    "seed:personality": "ts-node -r tsconfig-paths/register src/scripts/seed-personality.ts",
    "seed:bilan": "ts-node -r tsconfig-paths/register src/scripts/seed-bilan.ts",
    "sync:rome": "ts-node -r tsconfig-paths/register src/scripts/sync-rome-jobs.ts",
    "sync:rome:cron": "ts-node -r tsconfig-paths/register src/scripts/sync-rome-jobs.ts --cron",
    "sync:market": "ts-node -r tsconfig-paths/register src/scripts/sync-market-stats.ts",
    "remap:rome": "ts-node -r tsconfig-paths/register src/scripts/remap-rome-jobs.ts",
    "remap:market": "ts-node -r tsconfig-paths/register src/scripts/remap-market-stats.ts",
    "admin:promote": "ts-node -r tsconfig-paths/register src/scripts/promote-admin.ts",
    "reset:swipes": "ts-node -r tsconfig-paths/register src/scripts/reset-swipes.ts",
    "mongo:start": "docker compose up -d mongo",
    "mongo:stop": "docker compose stop mongo",
    "mongo:logs": "docker compose logs -f mongo",
    "docker:dev": "docker compose --profile api up --build",
    "docker:cleanup": "docker compose --profile all up --build",
    "down": "docker compose down"
  },
  "packageManager": "yarn@1.22.19",
  "lint-staged": {
    "*.{js,cjs,json,md,yml,yaml}": "prettier --write",
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.16.1",
    "node-cron": "^4.2.0",
    "nodemailer": "^7.0.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.1",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.29.0",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.6.2",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  }
}
